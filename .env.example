# ── Server ──────────────────────────────────────────────────────────────────
PORT=3002

# ── Geo providers ───────────────────────────────────────────────────────────
# Public demo endpoints — fine for local dev, BAD for production. The public
# Nominatim instance is ~1 req/sec with no commercial use; OSRM and Photon
# demo servers are best-effort and will throttle a marketplace's traffic.
# In production, point these at self-hosted or paid OSM hosts (see README).
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
PHOTON_BASE_URL=https://photon.komoot.io
OSRM_BASE_URL=https://router.project-osrm.org

# Per-request timeout for any provider call. Above this, the controller
# returns a clean 504 instead of hanging.
GEO_REQUEST_TIMEOUT_MS=5000

# Nominatim policy requires a meaningful UA identifying the operator. Put a
# real contact address here when you own the hosted instance.
GEO_USER_AGENT=spotlessdoc-geo/1.0 (contact: support@spotlessdoc.com)

# ISO 3166-1 alpha-2 country codes for biasing geocode results. Comma-list,
# e.g. "us,ca". Default `us` matches the current DFW service area.
GEO_COUNTRY_CODES=us

# Max destinations per /distance-matrix call. OSRM's /table accepts more but
# the worst-case combinatorial cost grows fast — keep this small.
GEO_MAX_DESTINATIONS=25

# ── Rate limits ─────────────────────────────────────────────────────────────
# Standard limit for geocode / reverse / directions / distance-matrix.
GEO_RATE_LIMIT_WINDOW_MS=60000
GEO_RATE_LIMIT_MAX=60

# Higher budget for autocomplete (keystroke-driven, but cached + frontend-
# debounced — see README).
GEO_AUTOCOMPLETE_WINDOW_MS=60000
GEO_AUTOCOMPLETE_MAX=240

# ── Cache TTLs (ms) ─────────────────────────────────────────────────────────
# Optional overrides. Each kind has a sane default in geo.cache.js.
# GEO_CACHE_GEOCODE_TTL_MS=2592000000          # 30 days
# GEO_CACHE_REVERSE_TTL_MS=2592000000          # 30 days
# GEO_CACHE_AUTOCOMPLETE_TTL_MS=86400000       # 1 day
# GEO_CACHE_DIRECTIONS_TTL_MS=300000           # 5 minutes
# GEO_CACHE_DISTANCE_MATRIX_TTL_MS=300000      # 5 minutes
